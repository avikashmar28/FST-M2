show databases;
create database office;
use office;
CREATE TABLE employee (id INT, name STRING, dept STRING, yoj INT, salary INT) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',' TBLPROPERTIES ("skip.header.line.count"="1");
DESCRIBE employee;
LOAD DATA LOCAL INPATH '/root/EmpData.csv' INTO TABLE employee;
SELECT * FROM employee;
SELECT COUNT(*) FROM employee;
SELECT  id, name FROM employee;
SELECT * FROM employee WHERE salary > 30000;
SELECT count(*) FROM employee;
INSERT OVERWRITE DIRECTORY '/user/root/Avik_Ash/output/export' ROW FORMAT DELIMITED FIELDS TERMINATED BY ',' SELECT * FROM employee;
INSERT OVERWRITE LOCAL DIRECTORY '/export' ROW FORMAT DELIMITED FIELDS TERMINATED BY ',' SELECT * FROM employee; 
